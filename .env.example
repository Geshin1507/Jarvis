# ============================================================================
# J.A.R.V.I.S. configuration example.
#
# Copy to `.env` at the project root and edit. This file contains NO real
# secrets. Anything left blank is either optional or generated on first run.
# The backend reads this file; the frontend never sees it.
# ============================================================================

# --- Local AI provider (local-first is enforced) ---------------------------
# Only "ollama" is accepted. Cloud providers are rejected at startup.
LOCAL_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Keep the model resident so interactive commands skip the cold load.
OLLAMA_KEEP_ALIVE=30m
# Requested model. The variant is tried first; a bare name resolves to :latest.
PRIMARY_MODEL=gemma4
PRIMARY_MODEL_VARIANT=e2b
FALLBACK_MODELS=gemma4:latest,qwen2.5:0.5b
# Models that must never be selected (too large for this laptop).
BLOCKED_MODELS=gemma4:26b
BLOCK_CLOUD_MODELS=true

# --- Inference limits (tuned for a small laptop) ---------------------------
MAX_CONTEXT_TOKENS=8192
MAX_PARALLEL_REQUESTS=1
REQUEST_TIMEOUT_SECONDS=300
CLASSIFY_TIMEOUT_SECONDS=120
ENABLE_THINKING=false

# --- Feature flags ---------------------------------------------------------
ENABLE_BACKGROUND_AGENTS=false
ENABLE_VOICE=false
# Semantic search stays off unless a local embedding model is configured.
ENABLE_SEMANTIC_SEARCH=false
EMBEDDINGS_PROVIDER=none
ENABLE_N8N=false

# --- Voice (optional, local only) -----------------------------------------
# none | faster_whisper   (no cloud speech services are supported)
VOICE_STT_PROVIDER=none
# windows_sapi | none
VOICE_TTS_PROVIDER=windows_sapi

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/jarvis.db
DATA_DIR=./data
LOG_DIR=./logs
BACKUP_DIR=./backups

# --- Server ----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
EXTRA_ALLOWED_ORIGINS=

# --- Security --------------------------------------------------------------
# Leave blank to auto-generate and persist to data/secret.key on first run.
SESSION_SECRET=
SESSION_TTL_HOURS=12
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# Leave blank to have a strong password generated and printed once by `jarvis seed`.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Research engine (polite, rate-limited) --------------------------------
RESEARCH_USER_AGENT=JarvisLocalBot/0.1 (+local research; contact: admin@localhost)
RESEARCH_MIN_DOMAIN_DELAY_SECONDS=3.0
RESEARCH_MAX_PAGES_PER_JOB=15
RESEARCH_MAX_PAGE_BYTES=2000000
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_CACHE_TTL_HOURS=24
RESEARCH_RESPECT_ROBOTS=true

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
# Scheduled external sending stays disabled. There is no supported way to
# enable unattended sending of email/WhatsApp/calls.
SCHEDULED_SENDING_ENABLED=false
